#!/bin/sh
. "$(dirname "$0")/_/husky.sh"
protected="^(refs/heads/(main|staging))$"
while read local_ref local_sha remote_ref remote_sha
do
  if echo "$remote_ref" | grep -E "$protected" >/dev/null; then
    echo "?? Push direto para main/staging bloqueado. Abra um PR a partir de dev."
    exit 1
  fi
done
exit 0
